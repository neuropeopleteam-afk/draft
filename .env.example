# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- PostgreSQL (контейнер db) ---
POSTGRES_DB=fsp
POSTGRES_USER=fsp
# Сгенерируйте: openssl rand -hex 24  (только [a-f0-9], чтобы не экранировать в URL)
POSTGRES_PASSWORD=

# --- API ---
# Сгенерируйте: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_MINUTES=720
# Пусто — DEV_MODE включается автоматически, пока не настроен Postbox.
# true — код подтверждения пишется в лог и возвращается в ответе API (только для разработки!)
DEV_MODE=
# «Песочница жюри»: снимает ограничение смены грейда раз в 90 дней
DEMO_SANDBOX=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8140
PUBLIC_BASE_URL=http://localhost:8140

# --- Почта: Yandex Cloud Postbox (HTTPS API, SESv2-совместимый) ---
# Ключи кладутся в отдельный файл (по умолчанию ./secrets/postbox.env):
#   POSTBOX_ACCESS_KEY_ID=...
#   POSTBOX_SECRET_ACCESS_KEY=...
POSTBOX_ENV_FILE=./secrets/postbox.env
MAIL_FROM=noreply@neuropeople.pro

# --- LLM: провайдер-агностичный OpenAI-совместимый клиент ---
# Ключи — в отдельном файле (по умолчанию ./secrets/llm.env, на сервере /opt/spectrek_fsp/secrets/llm.env):
#   LLM_PROVIDER=yandex_ai_studio          # или openai_compatible
#   LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
#   LLM_API_KEY=...                        # Yandex: заголовок «Authorization: Api-Key …»
#   LLM_FOLDER_ID=...                      # Yandex: заголовок «OpenAI-Project: …»
#   LLM_MODEL=gpt://<folder>/yandexgpt/latest
# Нет файла или LLM_DISABLED=true — разбор потребностей и резюме идёт по словарям и правилам.
LLM_ENV_FILE=./secrets/llm.env
LLM_TIMEOUT_S=25
LLM_DISABLED=false
# Модель для оценки открытых ответов теста по рубрике (пусто — LLM_MODEL); без LLM ответ уходит «на проверку»
# LLM_GRADING_MODEL=gpt-oss-120b/latest
# Цепочка провайдеров (docs/LLM.md): порядок; пусто — один провайдер из LLM_ENV_FILE, как раньше.
#   openrouter — OPENROUTER_API_KEY, OPENROUTER_BASE_URL в OPENROUTER_ENV_FILE; ретранслятор LLM_RELAY_URL
#   (OpenAI-совместимый адрес с /api/v1) и LLM_RELAY_TOKEN (заголовок X-Relay-Token) — в LLM_RELAY_ENV_FILE.
#   Собственный сертификат ретранслятора (самоподписанный): LLM_RELAY_CA_PEM_B64 (PEM в base64) или LLM_RELAY_CA_FILE —
#   тогда TLS ретранслятора проверяется только по нему.
# LLM_CHAIN=openrouter,yandex
OPENROUTER_ENV_FILE=./secrets/openrouter.env
LLM_RELAY_ENV_FILE=./secrets/llm_relay.env
# Модель и тайм-аут на функцию (parse_need, resume, grade, grade_second): «модель» для первого провайдера
# цепочки или «openrouter=…,yandex=…». По умолчанию openrouter — anthropic/claude-sonnet-5.5, вторая оценка —
# anthropic/claude-fable-5.1; yandex — LLM_MODEL (оценка — LLM_GRADING_MODEL).
# LLM_MODEL_GRADE_SECOND=openrouter=anthropic/claude-fable-5.1
# Запасная Yandex для разбора — yandexgpt-5.1 (docs/LLM.md, раздел 6: 50 вакансий, медиана 2,4 с):
# LLM_MODEL_PARSE_NEED=yandex=yandexgpt-5.1/latest
# LLM_MODEL_RESUME=yandex=yandexgpt-5.1/latest
# LLM_TIMEOUT_PARSE_NEED=20
# Рассуждения моделей OpenRouter на функцию: low | medium | high | default (не передавать). По умолчанию разбор,
# резюме и вторая оценка — low, первая оценка — default
# LLM_REASONING_GRADE=default
# Вторая оценка: спорный ответ — балл у порога |x − 0,5| ≤ LLM_GRADING_NEAR и др.; расхождение больше
# LLM_GRADING_DISAGREE — эксперту; общий бюджет обеих оценок, с (меньше proxy_read_timeout nginx)
# LLM_GRADING_NEAR=0.05
# LLM_GRADING_DISAGREE=0.25
# LLM_GRADING_BUDGET_S=50
# И27: вторая оценка спорных ответов — в фоне (ответ получает балл первой оценки сразу); false — прежнее ожидание
# LLM_GRADING_SECOND_ASYNC=true
# И27: кэш разбора потребности по нормализованному тексту, с (ключ — sha256 текста, без ПДн)
# PARSE_CACHE_TTL_S=3600
# Автомат-выключатель: после N ошибок подряд пара «провайдер + модель» пропускается M секунд
# LLM_BREAKER_FAILURES=3
# LLM_BREAKER_COOLDOWN_S=60
# Открытая модель на этой машине без ключей и без зарубежных API (docs/LLM.md, раздел 9): `make llm-local` —
# сервис llm-local (llama.cpp server, Qwen3.5-9B Q4_K_M на CPU, модель скачивается при первом старте) и LLM_CHAIN=local
# из infra/llm-local/llm-local.env. Постоянно — раскомментировать две строки:
# COMPOSE_PROFILES=llm-local
# LLM_LOCAL_ENV_FILE=./infra/llm-local/llm-local.env
# Машина 8 ГБ: модель полегче (2,7 ГБ) и предел памяти контейнера модели (по умолчанию 8g — для 9B, ей нужно 6,6 ГБ)
# LLM_LOCAL_HF_REPO=unsloth/Qwen3.5-4B-GGUF:Q4_K_M
# LLM_LOCAL_MODEL=qwen3.5-4b
# LLM_LOCAL_MEM_LIMIT=4g
# Потоки CPU (по умолчанию — nproc, все доступные контейнеру ядра)
# LLM_LOCAL_THREADS=8
# Движок теста: bank (пакет assessment_bank, адаптивный тест) | stub (заглушка из 6 вопросов)
ASSESSMENT_ENGINE=bank
# Адаптивный тест: 8–16 заданий, до 60 минут; остановка, когда грейд определён (ни один порог не в θ̂ ± 1,28·SE)
# или SE ≤ 0,35; у неопределённого порога — дотестирование до 6 коротких заданий (до 20 минут)
# ASSESSMENT_MIN_ITEMS=8
# ASSESSMENT_MAX_ITEMS=16
# ASSESSMENT_MAX_MINUTES=60
# ASSESSMENT_SE_TARGET=0.35
# ASSESSMENT_STOP_RULE=classification
# ASSESSMENT_CLASSIFY_Z=1.28
# ASSESSMENT_SELECT_AT=cut
# ASSESSMENT_EXTENSION_ITEMS=6
# ASSESSMENT_EXTENSION_MINUTES=20
# ASSESSMENT_EXTENSION_OWN_FIRST=true
# Не больше 2 open_book_3step и 1 open_answer в сессии
# ASSESSMENT_MAX_OPEN_BOOK=2
# ASSESSMENT_MAX_OPEN_ANSWER=1
# Ротация субпулов (повтор — другой субпул) и карантин утёкшего субпула (номера через запятую)
# ASSESSMENT_SUBPOOLS=2
# ASSESSMENT_SUBPOOL_QUARANTINE=
# Контроль частоты показа: sympson_hetter | none (K_f — backend/app/modules/assessment/exposure_k.json)
# ASSESSMENT_EXPOSURE=sympson_hetter
# Порог уверенности решения по уровню (подтверждение и «уровень ниже»): 0,6 по перебору на симуляции
# (docs/validation/GRADE_ACCURACY.md); при SE > 0,6 (экспресс/мини) — прежние 0,8
# ASSESSMENT_CONFIRM_LEVEL=0.6
# Позиция внутри уровня (нижняя / середина / верхняя часть) в результате и карточке — только когда SE позволяет
# GRADE_POSITION_ENABLED=false
# Чистка пула: 26 семейств, слабых по калибровке панелью моделей, не выдаются (assessment/weak_pool.py);
# на симуляции не лучше по всем ограничениям — по умолчанию выключено
# ASSESSMENT_WEAK_EXCLUDE=false
# Двухэтапное подтверждение у границы (Я26, docs/validation/TWO_STAGE.md): итог «на границе» → уточнение
# отдельной сессией до N коротких заданий и M минут, итог — по обеим сессиям; по умолчанию выключено.
# Значения по умолчанию — выбор симуляции (make two-stage): L 0,8, 8 заданий, 15 минут, c₂ 0,45
# ASSESSMENT_TWO_STAGE_ENABLED=false
# ASSESSMENT_TWO_STAGE_LEVEL=0.8
# ASSESSMENT_TWO_STAGE_ITEMS=8
# ASSESSMENT_TWO_STAGE_MINUTES=15
# ASSESSMENT_TWO_STAGE_CONFIRM=0.45
# Демо-режим жюри: вход в один клик (POST /api/jury/login), сброс демо (POST /api/jury/reset),
# у демо-учёток жюри правило 90 дней снято
JURY_MODE_AVAILABLE=true
# JURY_RESET_COOLDOWN_S=20
# Песочницы жюри (свой набор персон у каждого эксперта): всего хранится N, сверх — удаляются самые давние
# JURY_SANDBOXES_MAX=60
# Новых песочниц в час с одного адреса (жюри может сидеть за одним NAT; счётчик в памяти воркера) и всего (по БД,
# для всех воркеров). Сверх лимита вход в один клик идёт в общее демо.
# JURY_NEW_SANDBOXES_PER_IP_HOUR=40
# JURY_NEW_SANDBOXES_TOTAL_HOUR=120

# --- Второй фактор входа (TOTP, RFC 6238; backend/app/modules/auth/twofa.py) ---
# Роли, для которых второй фактор обязателен у реальных учёток (демо-учётки жюри входят в один клик без него)
# TWOFA_REQUIRED_ROLES=admin,fsp_analyst
# Ключ шифрования TOTP-секретов в базе (Fernet, base64 32 байта); пусто — выводится из JWT_SECRET
# TWOFA_SECRET_KEY=
# Издатель в приложении-аутентификаторе (по умолчанию PRODUCT_NAME); перебор: 5 неверных кодов → пауза 15 минут
# TWOFA_ISSUER=
# TWOFA_MAX_FAILS=5
# TWOFA_LOCK_MINUTES=15
# Служебные учётки создаются командой: python -m app.modules.auth add-staff --email admin@company.ru --role admin

# --- Интеграции (backend/app/integrations, docs/ANTIFRAUD.md, docs/FSP_INTEGRATION.md, docs/ATS.md) ---
# Внешний адрес платформы (ссылки в push, redirect_uri ФСП ID)
PUBLIC_BASE_URL=http://localhost:8140
# Ключ шифрования токенов ATS (Fernet, base64 32 байта); пусто — выводится из JWT_SECRET
# INTEGRATIONS_SECRET_KEY=
# Обратный канал «Поток» → платформа: опрос этапов кандидатов раз в N секунд (0 — только кнопкой «Обновить этапы»)
# ATS_STAGE_POLL_S=300
# Найм (docs/ATS.md §12): напоминания о собеседованиях раз в N секунд (0 — выключены); причина и автор отказа
# для «Потока» (decline.json) — id из справочника компании; без причины отказ уходит в «Поток» только комментарием
# HIRING_REMIND_POLL_S=300
# POTOK_DECLINE_REASON_ID=
# POTOK_AUTHOR_ID=
# Проверка работодателя в ЕГРЮЛ (egrul.nalog.ru): кэш 7 дней; EGRUL_DISABLED=true — без внешних запросов
# EGRUL_CACHE_DAYS=7
# EGRUL_DISABLED=false
# ФСП ID (демо): Keycloak в профиле compose fsp-id, путь /auth на том же домене
# COMPOSE_PROFILES=fsp-id
# FSP_ID_PUBLIC_URL=https://fsp.example.ru/auth
# FSP_OIDC_ISSUER=https://fsp.example.ru/auth/realms/fsp
# FSP_OIDC_INTERNAL_BASE=http://keycloak:8080/auth/realms/fsp
# Для внешнего стенда в docker-compose укажите INTERNAL_BASE равным его issuer:
# явный адрес переопределит демо-backchannel по умолчанию.
# FSP_OIDC_CLIENT_ID=spectrek-platform
# FSP_OIDC_SCOPES=openid email profile
# FSP_OIDC_DISCOVERY=true
# FSP_OIDC_TOKEN_AUTH_METHOD=client_secret_basic
# FSP_OIDC_CLAIMS_MAP={"fsp_id":"participant.id","fsp_rank":"participant.rank","fsp_achievements":"participant.results"}
# FSP_ID_DEMO=false
# FSP_REGISTRY_MODE=external
# FSP_REGISTRY_BASE_URL=https://registry.example/api/fsp-registry/v1
# FSP_REGISTRY_TOKEN=  # только в secrets/fsp_id.env
# Мок по HTTP: MODE=mock, BASE_URL=http://127.0.0.1:8000/api/fsp-registry/v1
# FSP_OIDC_CLIENT_ID=spectrek-platform
# Секреты — в отдельных файлах вне репозитория (chmod 600), подключаются через env_file:
#   FSP_ID_ENV_FILE  → FSP_OIDC_CLIENT_SECRET, FSP_DEMO_PASSWORD
#   KEYCLOAK_ENV_FILE → KC_BOOTSTRAP_ADMIN_USERNAME, KC_BOOTSTRAP_ADMIN_PASSWORD
#   VAPID_ENV_FILE   → VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT (Web Push)
# FSP_ID_ENV_FILE=/opt/spectrek_fsp/secrets/fsp_id.env
# KEYCLOAK_ENV_FILE=/opt/spectrek_fsp/secrets/keycloak.env
# VAPID_ENV_FILE=/opt/spectrek_fsp/secrets/vapid.env
# ATS: Хантфлоу API v2 по умолчанию; токены работодатель задаёт в кабинете (хранятся зашифрованными)
# HUNTFLOW_DEFAULT_BASE_URL=https://api.huntflow.ru/v2
# ATS_TIMEOUT_S=10
# ATS_MAX_ATTEMPTS=3
# Talantix (GraphQL) и «Поток» (REST v3): адреса API по умолчанию; User-Agent для Talantix обязателен — контакт
# TALANTIX_BASE_URL=https://api.talantix.ru
# POTOK_BASE_URL=https://app.potok.io/api/v3
# ATS_USER_AGENT_CONTACT=hr@example.ru
# Начальные токены ATS — только в файле секретов (на сервере /opt/spectrek_fsp/secrets/ats.env), не в .env:
# ATS_ENV_FILE=/opt/spectrek_fsp/secrets/ats.env

# --- Подписанный паспорт грейда (backend/app/passport, страница /verify/<id>, tools/passport/) ---
# Ключ подписи Ed25519 — секрет, только в отдельном файле (на сервере /opt/spectrek_fsp/secrets/passport.env):
#   python tools/passport/genkey.py > secrets/passport.env && chmod 600 secrets/passport.env
# В файле одна строка PASSPORT_SIGNING_KEY=<base64url seed> (или PEM PKCS#8); здесь, в .env, ключ не задаётся.
# Нет ключа — эфемерный «тестовый ключ» процесса: паспорт и JWKS помечены test_key, страница проверки об этом пишет.
# PASSPORT_ENV_FILE=/opt/spectrek_fsp/secrets/passport.env
# PASSPORT_SIGNING_KEY=
# Ротация по kid: открытые ключи прежних ключей хранятся в БД (passport_keys) автоматически; если БД переносится
# без неё — открытые ключи (base64url) через запятую:
# PASSPORT_RETIRED_PUBLIC_KEYS=
# Срок действия паспорта от даты теста, дней
# PASSPORT_TTL_DAYS=365

# --- Производительность api (docs/LOAD.md, раздел 8) ---
# Воркеры uvicorn (по умолчанию 2) и лимит памяти контейнера api (≈ 700 МиБ на воркер под нагрузкой)
# API_WORKERS=2
# API_MEM_LIMIT=3072m   # с 10.10 (было 1536m; пик 1471 МиБ при 100 пользователях)
# Пул соединений с PostgreSQL на воркер: API_WORKERS × (DB_POOL_SIZE + DB_MAX_OVERFLOW) ≤ PG_MAX_CONNECTIONS − 14
# (Keycloak 6, резерв суперпользователя 3, миграции, резервная копия и консоль ≈ 5). Не дождались соединения за
# DB_POOL_TIMEOUT_S — ответ 503 db_busy с Retry-After (DB_BUSY_RETRY_AFTER_S), фронтенд повторяет GET.
# DB_POOL_SIZE=8
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_S=10
# DB_BUSY_RETRY_AFTER_S=3
# PG_MAX_CONNECTIONS=50
# Готовый ответ /api/validation/report на воркер, секунд (0 — считать на каждый запрос)
# VALIDATION_REPORT_TTL_S=20

# --- Подбор: флаги порядка (по умолчанию — как в продукте) ---
# Ядро роли (Я1): кандидат без основного языка / фреймворка / специализации роли идёт ниже (match-v1.2);
# 0 — прежний порядок match-v1.1. Замер — docs/core_skill/README.md
# RANK_CORE_SKILL=1
# Добор ступенью выше при малом пуле точного уровня (Я12б, match-v1.3): вкл. по умолчанию (решение владельца 11.10),
# выключение — MATCH_GRADE_ABOVE=0 (прежний порядок match-v1.2). Замер — docs/grade_above/README.md, docs/validation/HH_MATCH.md
# MATCH_GRADE_ABOVE=1
# Потолок компоненты теста на пороге следующего грейда (Я28): по умолчанию выкл. — правило «не хуже» не пройдено
# (docs/validation/MATCHING_COMPARE.md); включение — MATCH_GRADE_CAP=1
# MATCH_GRADE_CAP=0

# --- Каталог: 4 новых направления (DevOps / SRE, инженер данных, мобильная разработка, системный / бизнес-аналитик) ---
# По умолчанию выключено. С флагом видны только направления, чей банк заданий прошёл проверку (directions_verified в
# backend/assessment_bank/BANK_SYNC.json и правило: семейств ≥ CATALOG_EXT_MIN_FAMILIES, на каждый грейд ≥
# CATALOG_EXT_MIN_PER_GRADE). CATALOG_EXT_DIRECTIONS — только перечисленные (через запятую), пусто — все готовые.
# CATALOG_EXT_ENABLED=0
# CATALOG_EXT_DIRECTIONS=
# CATALOG_EXT_MIN_FAMILIES=18
# CATALOG_EXT_MIN_PER_GRADE=3

# --- hh.ru: импорт своей вакансии работодателя и «Рынок по hh.ru» (backend/app/modules/hh, docs/INTEGRATIONS.md) ---
# Токен приложения — только в отдельном файле (на сервере /opt/spectrek_fsp/secrets/hh.env):
#   HH_APP_TOKEN=<токен приложения>  HH_USER_AGENT=<Название/версия (почта)>
# client id/secret не нужны: повторный запрос токена ОТЗЫВАЕТ действующий. По умолчанию выключено.
# HH_ENV_FILE=/opt/spectrek_fsp/secrets/hh.env
# HH_ENABLED=false
# HH_STUB=false            # true — заглушка с фикстурой вместо api.hh.ru (тесты, CI, e2e; данные не настоящие)
# HH_CACHE_DIR=/tmp/hh_cache
# HH_MIN_INTERVAL_S=1      # не чаще 1 запроса в секунду на все воркеры
# HH_MARKET_TTL_S=86400    # кэш «Рынка по hh.ru» — 24 ч

# --- Тарифы работодателя и «Польза для ФСП» (backend/app/modules/tariffs, docs/TARIFFS.md) ---
# Цены и лимиты — backend/app/modules/tariffs/plans.py (сейчас демонстрационные, оплаты нет — демо-счёт). По умолчанию выкл.
# TARIFFS_ENABLED=false

# --- Порты на 127.0.0.1 ---
WEB_PORT=8140
API_PORT=8141
KEYCLOAK_PORT=8142

# Название продукта (рабочее) — единственное место; интерфейс берёт его из /api/meta
# PRODUCT_NAME=Драфт
