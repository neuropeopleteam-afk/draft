# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- PostgreSQL (контейнер db) ---
POSTGRES_DB=fsp
POSTGRES_USER=fsp
# Сгенерируйте: openssl rand -hex 24  (только [a-f0-9], чтобы не экранировать в URL)
POSTGRES_PASSWORD=

# --- API ---
# Сгенерируйте: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_MINUTES=720
# Пусто — DEV_MODE включается автоматически, пока не настроен Postbox.
# true — код подтверждения пишется в лог и возвращается в ответе API (только для разработки!)
DEV_MODE=
# «Песочница жюри»: снимает ограничение смены грейда раз в 90 дней
DEMO_SANDBOX=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8140
PUBLIC_BASE_URL=http://localhost:8140

# --- Почта: Yandex Cloud Postbox (HTTPS API, SESv2-совместимый) ---
# Ключи кладутся в отдельный файл (по умолчанию ./secrets/postbox.env):
#   POSTBOX_ACCESS_KEY_ID=...
#   POSTBOX_SECRET_ACCESS_KEY=...
POSTBOX_ENV_FILE=./secrets/postbox.env
MAIL_FROM=noreply@neuropeople.pro

# --- LLM (OpenRouter) — только из окружения ---
OPENROUTER_API_KEY=

# --- Порты на 127.0.0.1 ---
WEB_PORT=8140
API_PORT=8141
KEYCLOAK_PORT=8142
