# Пример файла сайта для nginx хоста (копия рабочего конфига стенда, без секретов).
# Пароль базовой авторизации хранится только в htpasswd на сервере, в репозиторий не попадает:
#   htpasswd -c /etc/nginx/htpasswd_spectrek_fsp demo   # затем: nginx -t && systemctl reload nginx
# Доступ к стенду для жюри: demo / Hakaton (решение владельца на время конкурса).

# Спецтрек ФСП — fsp.neuropeople.pro → контейнер web (127.0.0.1:8140).
# Отдельный файл сайта; другие сайты не затрагивает. Сертификат: certbot certonly --webroot (/opt/spectrek_fsp/acme).
# Сайт закрыт базовой авторизацией (логин demo) до решения владельца. API, манифест PWA и service worker — без неё:
# у API своя авторизация (JWT в заголовке Authorization), манифест браузер запрашивает без учётных данных.
server {
    listen 80;
    listen [::]:80;
    server_name fsp.neuropeople.pro;

    location /.well-known/acme-challenge/ {
        root /opt/spectrek_fsp/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name fsp.neuropeople.pro;

    ssl_certificate /etc/letsencrypt/live/fsp.neuropeople.pro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fsp.neuropeople.pro/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    client_max_body_size 10m;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;

    location = /robots.txt {
        add_header Content-Type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8140;
    }

    location ~* ^/(manifest\.webmanifest|manifest\.json|sw\.js|service-worker\.js|icons/|favicon) {
        proxy_pass http://127.0.0.1:8140;
    }

    # ФСП ID (демо, Keycloak) — без базовой авторизации: у Keycloak свой вход; админка закрыта в контейнере web
    location /auth/ {
        auth_basic off;
        proxy_pass http://127.0.0.1:8140;
        proxy_buffer_size 64k;
        proxy_buffers 8 64k;
        proxy_busy_buffers_size 128k;
    }

    # Живая демонстрация для жюри: /j/<код>, /assets/, /recover.js — без пароля (QR с телефона эксперта)
    include /etc/nginx/snippets/spectrek_fsp_jury_live.conf;

    # Публичная проверка паспорта грейда: только /verify/<id> — без пароля (/verify для почты остаётся закрытым)
    include /etc/nginx/snippets/spectrek_fsp_passport.conf;

    location / {
        auth_basic "FSP demo";
        auth_basic_user_file /etc/nginx/htpasswd_spectrek_fsp;
        proxy_pass http://127.0.0.1:8140;
    }
}
