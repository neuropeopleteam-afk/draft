# Настройки мониторинга стенда: скопировать в /opt/spectrek_fsp/infra/monitor.env (chmod 600).
# Ключи Postbox и Yandex AI Studio берутся из секретов приложения (MONITOR_ENV_FILES), сюда их не копировать.

# Кому писать (через запятую) — почта владельца стенда. Пусто — письма не отправляются, итог только в журнале.
MONITOR_TO=
# От кого: адрес домена, подтверждённого в Postbox (по умолчанию MAIL_FROM приложения)
#MONITOR_FROM=noreply@neuropeople.pro
MONITOR_BASE_URL=https://fsp.neuropeople.pro
MONITOR_ENV_FILES=/opt/spectrek_fsp/secrets/postbox.env,/opt/spectrek_fsp/secrets/llm.env
# Сбой — после N неудач подряд (разовый тайм-аут не будит); напоминание — раз в N часов, пока не прошло
MONITOR_FAILS=2
MONITOR_REMIND_H=6
# Yandex AI Studio: платный короткий запрос — не чаще раза в N секунд
MONITOR_LLM_EVERY_S=3600
MONITOR_DISK_PATH=/
MONITOR_DISK_MAX_PCT=90
MONITOR_MEM_MAX_PCT=90
MONITOR_CONTAINERS=spectrek_fsp-api-1,spectrek_fsp-db-1,spectrek_fsp-web-1
MONITOR_BACKUP_DIR=/opt/spectrek_fsp/backups/db
MONITOR_BACKUP_MAX_H=30
# 1 — проверять, что страница QR /j/… открыта без пароля (после установки фрагмента nginx jury-live)
MONITOR_CHECK_JURY_LIVE=0
MONITOR_STATE=/var/lib/spectrek-monitor/state.json
