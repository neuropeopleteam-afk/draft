# Открытая модель на этой машине: профиль docker compose llm-local (docs/LLM.md, раздел 9).
# Подключается к api командой `make llm-local` (LLM_LOCAL_ENV_FILE=./infra/llm-local/llm-local.env).
# Разбор потребности, резюме и оценка открытых ответов идут в Qwen на CPU (сервис llm-local, llama.cpp server);
# пока модель скачивается или если она не ответила — правила и словари, ответ на проверку эксперту.
# Облачные провайдеры (OpenRouter, Yandex) не используются: ключи не нужны, в интернет уходит только загрузка модели.
LLM_DISABLED=false
LLM_CHAIN=local
# Адрес и модель задаёт docker-compose.yml (LLM_LOCAL_BASE_URL, LLM_LOCAL_MODEL — по умолчанию сервис llm-local).
# Тайм-аут попытки на CPU, с: веб-сервер ждёт ответ api не дольше 60 с (proxy_read_timeout), поэтому 50.
LLM_LOCAL_TIMEOUT_S=50
# Оценка ответа теста: первая и вторая оценка (той же моделью, критерии в обратном порядке) в одном бюджете;
# не уложились — ответ «на проверке» и уходит эксперту (как при недоступной модели).
LLM_GRADING_BUDGET_S=50
# Модель недоступна три раза подряд (ещё скачивается, не хватило памяти) — 60 с не ждём её, сразу правила.
LLM_BREAKER_FAILURES=3
LLM_BREAKER_COOLDOWN_S=60
